import os
import json
from PIL import Image
from gtts import gTTS
import gradio as gr
from google import genai
from google.genai import types

# ==========================================
# 2. GEMINI API SETUP
# ==========================================
# Google AI Studio API key-ai inge add pannunga
GEMINI_API_KEY = "YOUR_GEMINI_API_KEY_HERE"
client = genai.Client(api_key=GEMINI_API_KEY)

# ==========================================
# 3. STRUCTURED SYSTEM PROMPT & GUARDRAILS
# ==========================================
SYSTEM_INSTRUCTION = """
You are a Senior Trust & Safety Threat Analyst and Quality Control Specialist.
Analyze the provided screenshot (payment receipt, banking portal, chat, APK download, or Ad creative) along with any text context.

Evaluate strictly against:
1. Phishing & Impersonation (Fake bank logos, suspicious URLs).
2. Deceptive Urgency & Financial Scam Claims (Lottery, fake electricity bill disconnect notices, unauthorized payment confirmations).
3. Malicious APK or Credential Harvest patterns.

Output STRICTLY in the following JSON format:
{
  "risk_level": "HIGH RISK" or "MEDIUM RISK" or "SAFE",
  "threat_category": "Phishing / Fake Urgent Bill / Payment Fraud / False Claims / Clean",
  "confidence_score": (integer 0 to 100),
  "root_cause_analysis": "Clear explanation of visual artifacts, deceptive keywords, or policy violation signals detected.",
  "recommended_action_english": "Immediate actionable steps to avoid fraud.",
  "audio_advisory_tamil": "A short 1-2 sentence spoken advisory in simple conversational Tamil warning the user and giving actionable safety advice."
}
"""

# ==========================================
# 4. CORE EVALUATION PIPELINE
# ==========================================
def evaluate_threat(screenshot_img, text_context, source_info):
    if screenshot_img is None and not text_context:
        return (
            "<div style='color: #ef4444; font-weight: bold; padding: 12px;'>⚠️ Please provide an image screenshot or text payload to analyze.</div>",
            None
        )

    contents = []
    if screenshot_img is not None:
        contents.append(screenshot_img)
    if text_context:
        contents.append(f"Context Text / Message: {text_context}")
    if source_info:
        contents.append(f"Source Sender / URL: {source_info}")

    try:
        response = client.models.generate_content(
            model="gemini-3.6-flash",
            contents=contents,
            config=types.GenerateContentConfig(
                system_instruction=SYSTEM_INSTRUCTION,
                response_mime_type="application/json",
                temperature=0.1
            )
        )
        
        result = json.loads(response.text)
        
        risk = result.get("risk_level", "HIGH RISK")
        category = result.get("threat_category", "Unknown Threat")
        confidence = result.get("confidence_score", 0)
        rca = result.get("root_cause_analysis", "No explanation available.")
        action_en = result.get("recommended_action_english", "Do not engage.")
        tamil_advisory = result.get("audio_advisory_tamil", "Indha seidhiya thodaraatheenga.")

        # Visual Card Styling
        if risk == "SAFE":
            color = "#10b981"
            bg = "#ecfdf5"
            badge_icon = "✅"
        elif risk == "MEDIUM RISK":
            color = "#f59e0b"
            bg = "#fffbeb"
            badge_icon = "⚠️"
        else:
            color = "#ef4444"
            bg = "#fef2f2"
            badge_icon = "🚨"

        card_html = f"""
        <div style='background: {bg}; border: 2px solid {color}; border-radius: 12px; padding: 20px; font-family: sans-serif;'>
            <div style='display: flex; justify-content: space-between; align-items: center;'>
                <div style='font-size: 20px; font-weight: 800; color: {color};'>
                    {badge_icon} {risk} — {category}
                </div>
                <div style='background: {color}; color: white; border-radius: 20px; padding: 4px 12px; font-weight: bold; font-size: 13px;'>
                    Confidence: {confidence}%
                </div>
            </div>
            
            <div style='margin-top: 16px; background: white; border-radius: 8px; padding: 14px; border: 1px solid #e2e8f0;'>
                <strong style='color: #1e293b; font-size: 14px;'>🔍 Threat Root Cause Analysis (RCA):</strong>
                <p style='color: #475569; margin: 6px 0 14px 0; line-height: 1.5;'>{rca}</p>
                
                <strong style='color: #1e293b; font-size: 14px;'>🛡️ Actionable Recommendation (EN):</strong>
                <div style='background: #f8fafc; padding: 10px; border-left: 4px solid {color}; border-radius: 4px; color: #0f172a; font-weight: 600; margin-top: 4px;'>
                    {action_en}
                </div>
                
                <div style='margin-top: 14px; padding-top: 10px; border-top: 1px dashed #cbd5e1;'>
                    <strong style='color: #4338ca; font-size: 13px;'>🗣️ Vernacular Advisory (Tamil Audio Transcript):</strong>
                    <p style='color: #334155; margin: 4px 0 0 0; font-style: italic;'>"{tamil_advisory}"</p>
                </div>
            </div>
        </div>
        """

        # Generate Tamil Audio Advisory
        audio_path = "advisory_output.mp3"
        tts = gTTS(text=tamil_advisory, lang='ta', slow=False)
        tts.save(audio_path)

        return card_html, audio_path

    except Exception as e:
        err_html = f"<div style='color: #ef4444; padding: 12px; font-weight: bold;'>❌ Error executing evaluation: {str(e)}</div>"
        return err_html, None

# ==========================================
# 5. GRADIO USER INTERFACE
# ==========================================
CUSTOM_THEME = gr.themes.Soft(
    primary_hue="indigo",
    neutral_hue="slate"
)

with gr.Blocks(theme=CUSTOM_THEME, title="ScamShield AI") as demo:
    gr.HTML("""
    <div style='background: linear-gradient(135deg, #1e1b4b 0%, #4338ca 100%); padding: 22px; border-radius: 12px; color: white; margin-bottom: 16px;'>
        <h2 style='margin: 0; font-size: 24px;'>🛡️ ScamShield — Multimodal Threat Evaluation & Vernacular CX Engine</h2>
        <p style='margin: 6px 0 0 0; font-size: 14px; opacity: 0.9;'>Automated Quality Control, Deceptive Content Auditing & Audio Advisory (Gemini 3.6 Flash)</p>
    </div>
    """)

    with gr.Row():
        with gr.Column(scale=5):
            input_image = gr.Image(type="pil", label="Upload Deceptive Screenshot / Ad / Message")
            input_text = gr.Textbox(placeholder="e.g., 'Dear customer, electricity bill pending. Click here to avoid disconnection...'", label="Context Text / SMS Payload", lines=3)
            input_source = gr.Textbox(placeholder="e.g., Sender ID: +91-XXXXX or URL: bit.ly/secure-pay", label="Sender ID / Destination URL")
            analyze_btn = gr.Button("⚡ Run Multimodal Threat Audit", variant="primary")

        with gr.Column(scale=6):
            output_html = gr.HTML(label="Policy Decision & Scorecard")
            output_audio = gr.Audio(label="🔊 Vernacular Audio Advisory (Tamil)", autoplay=False)

    analyze_btn.click(
        fn=evaluate_threat,
        inputs=[input_image, input_text, input_source],
        outputs=[output_html, output_audio]
    )

demo.launch(share=True)
